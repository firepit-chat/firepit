{
    "name": "firepit-web",
    "version": "2.2.0-canary.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "dev:webpack": "next dev --webpack",
        "prebuild": "bun run build:workspace-deps",
        "build": "bun run generate-version && next build",
        "build:workspace-deps": "cd ../.. && bunx turbo run build --filter='@firepit-chat/*'",
        "build:webpack": "bun run generate-version && next build --webpack",
        "build:analyze": "ANALYZE=true next build --webpack",
        "generate-version": "bun scripts/generate-version.ts",
        "start": "next start",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint --cache \"**/*.{ts,tsx,js,mjs,cjs}\"",
        "lint:fix": "eslint \"**/*.{ts,tsx,js,mjs,cjs}\" --fix",
        "typecheck": "tsc --noEmit",
        "check": "bun run lint",
        "check:openapi": "bun scripts/check-openapi-sync.ts",
        "generate:api-types": "openapi-typescript docs/openapi-doc.yml -o src/lib/api/schema.ts",
        "check:api-types": "bun scripts/check-api-types-fresh.ts",
        "setup": "bun scripts/setup-appwrite.ts",
        "validate-env": "bun scripts/validate-env.ts",
        "validate-env:ci": "bun scripts/validate-ci-env.ts",
        "cleanup-orphan-memberships": "bun run scripts/cleanup-orphan-memberships.ts",
        "backfill-thread-read-ids": "bun run scripts/backfill-thread-read-ids.ts",
        "knip": "knip",
        "update:force": "bun i next@latest appwrite@latest node-appwrite@latest",
        "update:pin": "bun i next@latest appwrite@latest node-appwrite@latest --save-exact",
        "update:check": "bun outdated next appwrite node-appwrite"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@firepit-chat/markdown-spoiler": "workspace:*",
        "@opentelemetry/api-logs": "^0.221.0",
        "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
        "@opentelemetry/resources": "^2.11.0",
        "@opentelemetry/sdk-logs": "^0.221.0",
        "@opentelemetry/sdk-node": "^0.221.0",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tabs": "^1.1.21",
        "@tanstack/react-query": "^5.104.0",
        "@teispace/next-themes": "3.0.2",
        "@testing-library/dom": "^10.4.2",
        "appwrite": "^26.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "emoji-picker-react": "^4.22.3",
        "expo-server-sdk": "^6.1.0",
        "libsodium-wrappers": "^0.8.4",
        "lucide-react": "^0.554.0",
        "nanoid": "^5.1.16",
        "next": "^16.3.8",
        "node-appwrite": "^29.0.0",
        "node-emoji": "^2.2.0",
        "posthog-js": "^1.435.6",
        "posthog-node": "^5.55.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-markdown": "^10.1.0",
        "react-virtuoso": "^4.18.16",
        "remark-gfm": "^4.0.1",
        "server-only": "^0.0.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@happy-dom/global-registrator": "^20.14.5",
        "@next/bundle-analyzer": "16.3.1",
        "@posthog/nextjs-config": "^1.11.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/jest-dom": "^6.10.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/jsdom": "^27.0.0",
        "@types/node": "^20.19.43",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "@typescript-eslint/parser": "^8.71.0",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^3.2.7",
        "dotenv": "^17.4.2",
        "eslint": "^9.39.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^6.1.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^16.5.0",
        "happy-dom": "^20.14.5",
        "jsdom": "^27.4.0",
        "knip": "^6.39.0",
        "openapi-typescript": "7.13.0",
        "postcss": "^8.5.28",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "vitest": "^4.1.11"
    },
    "packageManager": "bun@1.4.2",
    "engines": {
        "node": ">=20.9.0"
    },
    "overrides": {
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4"
    }
}
