{
    "name": "firepit-web",
    "version": "2.2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "dev:webpack": "next dev --webpack",
        "prebuild": "bun run build:workspace-deps",
        "build": "bun run generate-version && next build",
        "build:workspace-deps": "cd ../.. && bunx turbo run build --filter='@firepit-chat/*'",
        "build:webpack": "bun run generate-version && next build --webpack",
        "build:analyze": "ANALYZE=true next build --webpack",
        "generate-version": "bun scripts/generate-version.ts",
        "start": "next start",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "oxlint --type-aware --react-perf-plugin --nextjs-plugin --react-plugin --jsx-a11y-plugin",
        "lint:fix": "oxlint --fix --type-aware --react-perf-plugin --nextjs-plugin --react-plugin --jsx-a11y-plugin",
        "typecheck": "bun check",
        "check:openapi": "bun scripts/check-openapi-sync.ts",
        "generate:api-types": "openapi-typescript docs/openapi-doc.yml -o src/lib/api/schema.ts",
        "check:api-types": "bun scripts/check-api-types-fresh.ts",
        "setup": "bun scripts/setup-appwrite.ts",
        "validate-env": "bun scripts/validate-env.ts",
        "validate-env:ci": "bun scripts/validate-ci-env.ts",
        "cleanup-orphan-memberships": "bun run scripts/cleanup-orphan-memberships.ts",
        "backfill-thread-read-ids": "bun run scripts/backfill-thread-read-ids.ts",
        "knip": "knip",
        "update:force": "bun i next@latest appwrite@latest node-appwrite@latest",
        "update:pin": "bun i next@latest appwrite@latest node-appwrite@latest --save-exact",
        "update:check": "bun outdated next appwrite node-appwrite"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@firepit-chat/markdown-spoiler": "workspace:*",
        "@noble/ciphers": "^2.4.0",
        "@noble/curves": "^2.4.0",
        "@noble/hashes": "^2.4.0",
        "@opentelemetry/api-logs": "^0.221.0",
        "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
        "@opentelemetry/resources": "^2.12.0",
        "@opentelemetry/sdk-logs": "^0.221.0",
        "@opentelemetry/sdk-node": "^0.221.0",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@tanstack/react-query": "^5.105.3",
        "@teispace/next-themes": "3.0.2",
        "@testing-library/dom": "^10.4.2",
        "appwrite": "^26.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "effect": "^4.1.2",
        "emoji-picker-react": "^4.22.3",
        "expo-server-sdk": "^6.1.0",
        "lucide-react": "^0.554.0",
        "nanoid": "^5.1.16",
        "next": "^16.4.5",
        "node-appwrite": "^31.1.0",
        "node-emoji": "^2.2.0",
        "posthog-js": "^1.445.1",
        "posthog-node": "^5.61.2",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-markdown": "^10.1.0",
        "react-virtuoso": "^4.18.20",
        "remark-gfm": "^4.0.1",
        "server-only": "^0.0.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^20.14.6",
        "@next/bundle-analyzer": "16.3.1",
        "@posthog/nextjs-config": "^1.12.0",
        "@scure/base": "^2.4.0",
        "@tailwindcss/postcss": "^4.3.4",
        "@testing-library/jest-dom": "^6.10.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/jsdom": "^27.0.0",
        "@types/node": "^20.19.43",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^3.2.7",
        "dotenv": "^17.4.2",
        "globals": "^16.5.0",
        "happy-dom": "^20.14.6",
        "jsdom": "^27.4.0",
        "knip": "^6.44.1",
        "libsodium-wrappers": "^0.8.4",
        "openapi-typescript": "7.13.0",
        "oxlint": "^1.91.0",
        "oxlint-tsgolint": "^7.0.2005",
        "postcss": "^8.5.32",
        "tailwindcss": "^4.3.4",
        "typescript": "~6.0.3",
        "vitest": "^4.1.12"
    },
    "packageManager": "bun@1.4.2",
    "engines": {
        "node": ">=20.9.0"
    }
}
