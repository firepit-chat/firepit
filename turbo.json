{
    "$schema": "https://v2-11-7.turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**"],
            "cache": true
        },
        "lint": {
            "cache": true
        },
        "test": {
            "dependsOn": ["^build"],
            "cache": true
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "cache": true
        }
    }
}
